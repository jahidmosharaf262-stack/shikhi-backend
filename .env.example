# GROQ API key (console.groq.com/keys থেকে ফ্রি নেবেন, কার্ড লাগে না)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# ঐচ্ছিক: কোন GROQ মডেল ব্যবহার হবে (ডিফল্ট: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Whisper মডেল সাইজ: tiny / base / small / medium (বড় মডেল = বেশি সঠিক কিন্তু ধীর)
WHISPER_MODEL_SIZE=base

# WhatsApp (Meta Cloud API) — Phase 4 করলে লাগবে
WHATSAPP_VERIFY_TOKEN=your-own-secret-string
WHATSAPP_ACCESS_TOKEN=meta-theke-paoya-token
WHATSAPP_PHONE_NUMBER_ID=meta-phone-number-id
